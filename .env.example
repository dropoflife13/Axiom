# ==============================================================================
# Axiom Environment Configuration Reference Template
# Curated free-tier LLM endpoints from mnfst/awesome-free-llm-apis
# (Only non-obsolete, active models verified for code & SQL generation)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini (Active Primary Provider - 1M Context, OpenAI Compatible)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_EXECUTOR_MODEL=gemini-3.8-flash
GEMINI_ADVISOR_MODEL=gemini-3.5-flash
# Alternative / high-speed Gemini models (200 OK verified):
GEMINI_FAST_MODEL=gemini-3.6-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
# NOTE: gemini-2.5-flash is OBSOLETE / DEPRECATED (returns 404).

# ------------------------------------------------------------------------------
# 2. NVIDIA NIM (Free Tier: 40 RPM, 10,000 RPD - build.nvidia.com)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3-flash
NVIDIA_FLASH_MODEL=deepseek-ai/deepseek-v4.1-flash
NVIDIA_CODE_MODEL=google/gemma-4-31b-it
NVIDIA_HEAVY_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# ------------------------------------------------------------------------------
# 3. Groq (Free Tier: 30 RPM, 1,000 RPD - LPU ultra-low latency)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_EXECUTOR_MODEL=openai/gpt-oss-120b
GROQ_ADVISOR_MODEL=qwen/qwen3.8-27b
GROQ_FAST_MODEL=openai/gpt-oss-20b
# NOTE: qwen/qwen3.6-27b was shut down in Sept 2026; use qwen3.8-27b.

# ------------------------------------------------------------------------------
# 4. Mistral AI (Permanent Free Mode: ~1 RPS, 500K TPM - console.mistral.ai)
# ------------------------------------------------------------------------------
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_CODE_MODEL=codestral-latest
MISTRAL_EXECUTOR_MODEL=mistral-small-latest

# ------------------------------------------------------------------------------
# 5. OpenRouter Free Pool (Free Tier: 20 RPM, 50 RPD - openrouter.ai)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_ROUTER=openrouter/free
OPENROUTER_CODE_MODEL=cohere/north-mini-code:free
OPENROUTER_GEMMA_MODEL=google/gemma-4-31b-it:free

# ------------------------------------------------------------------------------
# 6. Kilo Code (Free Models: 200 req/hr - No API Key Required)
# ------------------------------------------------------------------------------
KILO_BASE_URL=https://api.kilo.ai/api/gateway
KILO_AUTO_MODEL=kilo-auto/free
KILO_CODE_MODEL=cohere/north-mini-code:free
KILO_NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning:free

# ------------------------------------------------------------------------------
# 7. Cohere (Free Trial: 20 RPM, 1,000 calls/month - dashboard.cohere.com)
# ------------------------------------------------------------------------------
COHERE_API_KEY=your_cohere_api_key_here
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1
COHERE_MODEL=command-r-plus

# ------------------------------------------------------------------------------
# 8. Tier 3 Heavy Escalation Models
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# ------------------------------------------------------------------------------
# Guardrails & Budgets
# ------------------------------------------------------------------------------
AXIOM_DAILY_CALLS=700
AXIOM_CALL_TIMEOUT_MS=15000
AXIOM_MAX_LLM_CALLS=4
AXIOM_MAX_PROMPT_CHARS=16000
AXIOM_MAX_TIER3_CALLS=1
